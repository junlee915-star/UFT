---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getAllListings, collectTags, urls } from '@/lib/content';
const tags = collectTags(await getAllListings());
---

<BaseLayout title="태그" description="모든 태그 목록">
  <PageHeader title="태그" lead="단원, 위키 항목, 연구 노트, 논문 요약, 개념 글을 태그로 가로질러 찾는다." />
  <ul class="flex flex-wrap gap-2">
    {
      [...tags.entries()].map(([t, n]) => (
        <li>
          <a href={urls.tag(t)} class="inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 no-underline hover:no-underline" style="border-color: var(--line)">
            <span style="color: var(--fg)">#{t}</span>
            <span class="text-xs tabular-nums" style="color: var(--fg-muted)">{n}</span>
          </a>
        </li>
      ))
    }
  </ul>
  {tags.size === 0 && <p style="color: var(--fg-muted)">아직 태그가 없습니다.</p>}
</BaseLayout>
