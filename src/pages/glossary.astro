---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Badge from '@/components/Badge.astro';
import { getWiki, urls } from '@/lib/content';

const wiki = await getWiki();
// 위키에서 자동 생성한다. 항목을 추가하면 이 표가 따라 늘어난다.
const rows = wiki
  .map((w) => ({
    ko: w.data.titleKo,
    en: w.data.titleEn,
    aliases: w.data.aliases,
    tracks: w.data.tracks,
    slug: w.id,
  }))
  .sort((a, b) => a.ko.localeCompare(b.ko, 'ko'));
---

<BaseLayout title="한·영 용어 대조" description="개념 위키에서 자동 생성하는 한국어-영어 용어 대조표" wide>
  <PageHeader
    title="한·영 용어 대조"
    lead="개념 위키에서 자동 생성한다. 물리 용어는 한국물리학회 용어집을 1순위 기준으로 삼고, 용어집에 없는 말은 위키에 항목을 만들어 한글 번역과 원어를 확정한다."
  >
    <p class="mt-3 text-sm" style="color: var(--fg-muted)">{rows.length}개 용어</p>
    <label class="mt-4 flex max-w-md items-center gap-2 rounded-lg border px-3 py-2" style="border-color: var(--line)">
      <span class="sr-only">용어 거르기</span>
      <input
        id="glossary-filter"
        type="search"
        placeholder="한글·영어·다른 이름으로 거르기"
        class="w-full bg-transparent text-sm outline-none"
        autocomplete="off"
      />
    </label>
  </PageHeader>

  <div class="overflow-x-auto rounded-xl border" style="border-color: var(--line)">
    <table class="w-full text-sm">
      <thead style="background: var(--bg-2)">
        <tr class="text-left">
          <th class="px-4 py-2.5 font-semibold">한국어</th>
          <th class="px-4 py-2.5 font-semibold">원어</th>
          <th class="hidden px-4 py-2.5 font-semibold md:table-cell">다른 이름</th>
          <th class="px-4 py-2.5 font-semibold">트랙</th>
        </tr>
      </thead>
      <tbody class="divide-y" style="border-color: var(--line)">
        {
          rows.map((r) => (
            <tr data-term={[r.ko, r.en, ...r.aliases].join(' ').toLowerCase()} style="border-color: var(--line)">
              <td class="px-4 py-2.5"><a href={urls.wiki(r.slug)} class="font-medium">{r.ko}</a></td>
              <td class="px-4 py-2.5" style="color: var(--fg-muted)">{r.en}</td>
              <td class="hidden px-4 py-2.5 md:table-cell" style="color: var(--fg-muted)">{r.aliases.join(', ')}</td>
              <td class="px-4 py-2.5">
                <span class="flex flex-wrap gap-1">{r.tracks.map((t) => <Badge kind="track" value={t} small />)}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p id="glossary-empty" hidden class="mt-4 text-sm" style="color: var(--fg-muted)">해당하는 용어가 없습니다.</p>
</BaseLayout>

<script>
  const input = document.getElementById('glossary-filter') as HTMLInputElement | null;
  const rows = document.querySelectorAll<HTMLElement>('[data-term]');
  const empty = document.getElementById('glossary-empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach((r) => {
      const hit = !q || (r.dataset.term ?? '').includes(q);
      r.hidden = !hit;
      if (hit) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  });
</script>
