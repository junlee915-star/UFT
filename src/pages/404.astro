---
import { withBase } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없음" noindex>
  <div class="py-20 text-center">
    <p class="text-6xl font-black" style="color: var(--accent)">404</p>
    <h1 class="mt-4 text-2xl font-bold">페이지를 찾을 수 없습니다</h1>
    <p class="mt-2" style="color: var(--fg-muted)">주소가 바뀌었거나 아직 작성되지 않은 글일 수 있습니다.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href={withBase('/')} class="rounded-lg px-4 py-2 font-semibold text-white no-underline" style="background: var(--accent)">홈으로</a>
      <a href={withBase('/search')} class="rounded-lg border px-4 py-2 font-semibold no-underline" style="border-color: var(--line); color: var(--fg)">검색</a>
    </div>
  </div>
</BaseLayout>
