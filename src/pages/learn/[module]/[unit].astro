---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import Backlinks from '@/components/Backlinks.astro';
import { getEntry, render } from 'astro:content';
import { getPublished, getAllArticles, findBacklinks, urls, paths, withBase } from '@/lib/content';

export async function getStaticPaths() {
  const units = await getPublished('learn');
  return units.map((u) => {
    const [module, unit] = u.id.split('/');
    return { params: { module, unit }, props: { entry: u } };
  });
}
const { entry } = Astro.props;
const module = await getEntry('modules', entry.data.module);
const siblings = (await getPublished('learn')).filter((u) => u.data.module === entry.data.module).sort((a, b) => a.data.order - b.data.order);
const idx = siblings.findIndex((u) => u.id === entry.id);
const prev = idx > 0 ? siblings[idx - 1] : undefined;
const next = idx < siblings.length - 1 ? siblings[idx + 1] : undefined;
const prereqs = (await Promise.all(entry.data.prerequisites.map((id) => getEntry('learn', id)))).filter(
  (p): p is NonNullable<typeof p> => p !== undefined,
);
const { Content, headings } = await render(entry);
const backlinks = findBacklinks(await getAllArticles(), paths.unit(entry.id), entry);
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  kicker={module ? `모듈 ${module.data.order} · ${module.data.title} · ${entry.data.order}단원` : '학습'}
  kickerHref={urls.module(entry.data.module)}
  created={entry.data.created}
  updated={entry.data.updated}
  author={entry.data.author}
  tags={entry.data.tags}
  difficulty={entry.data.difficulty}
  status={entry.data.status}
  headings={headings}
  draft={entry.data.draft}
>
  <Fragment slot="meta">
    {
      prereqs.length > 0 && (
        <p class="mt-4 text-sm" style="color: var(--fg-muted)">
          선행 단원:{' '}
          {prereqs.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={urls.unit(p.id)}>{p.data.title}</a>
            </>
          ))}
        </p>
      )
    }
    {entry.data.estimatedMinutes && <p class="mt-1 text-sm" style="color: var(--fg-muted)">예상 학습 시간 {entry.data.estimatedMinutes}분</p>}
  </Fragment>

  <Content />

  <Fragment slot="after">
    <nav class="no-print mt-12 grid gap-4 sm:grid-cols-2" aria-label="단원 이동" data-pagefind-ignore>
      {
        prev ? (
          <a href={urls.unit(prev.id)} class="rounded-xl border p-4 no-underline hover:no-underline" style="border-color: var(--line)">
            <span class="text-xs" style="color: var(--fg-muted)">← 이전 단원</span>
            <span class="mt-1 block font-semibold" style="color: var(--fg)">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={urls.unit(next.id)} class="rounded-xl border p-4 text-right no-underline hover:no-underline" style="border-color: var(--line)">
            <span class="text-xs" style="color: var(--fg-muted)">다음 단원 →</span>
            <span class="mt-1 block font-semibold" style="color: var(--fg)">{next.data.title}</span>
          </a>
        ) : (
          <a href={withBase('/learn')} class="rounded-xl border p-4 text-right no-underline hover:no-underline" style="border-color: var(--line)">
            <span class="text-xs" style="color: var(--fg-muted)">모듈 완료</span>
            <span class="mt-1 block font-semibold" style="color: var(--fg)">학습 트랙으로 돌아가기</span>
          </a>
        )
      }
    </nav>
    <Backlinks entries={backlinks} title="이 단원을 참조하는 글" />
  </Fragment>

  <Fragment slot="aside">
    <div class="mt-8 text-sm">
      <p class="mb-2 font-semibold" style="color: var(--fg-muted)">이 모듈의 단원</p>
      <ol class="space-y-1">
        {
          siblings.map((u) => (
            <li>
              <a href={urls.unit(u.id)} class:list={['block truncate no-underline hover:underline', u.id === entry.id ? 'font-semibold' : '']} style={u.id === entry.id ? 'color: var(--fg)' : 'color: var(--fg-muted)'} aria-current={u.id === entry.id ? 'page' : undefined}>
                {u.data.order}. {u.data.title}
              </a>
            </li>
          ))
        }
      </ol>
      <button type="button" class="mt-6 text-xs underline" style="color: var(--fg-muted)" onclick="window.print()">PDF로 저장 / 인쇄</button>
    </div>
  </Fragment>
</ArticleLayout>
