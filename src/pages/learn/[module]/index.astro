---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Badge from '@/components/Badge.astro';
import { getCollection } from 'astro:content';
import { getPublished, urls } from '@/lib/content';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((m) => ({ params: { module: m.id }, props: { module: m } }));
}
const { module } = Astro.props;
const units = (await getPublished('learn')).filter((u) => u.data.module === module.id).sort((a, b) => a.data.order - b.data.order);
const totalMinutes = units.reduce((s, u) => s + (u.data.estimatedMinutes ?? 0), 0);
---

<BaseLayout title={module.data.title} description={module.data.summary}>
  <PageHeader kicker={`학습 트랙 · 모듈 ${module.data.order}`} title={module.data.title} lead={module.data.summary}>
    <div class="mt-4 flex flex-wrap gap-3 text-sm" style="color: var(--fg-muted)">
      <Badge kind="difficulty" value={module.data.difficulty} />
      <span>{units.length}개 단원</span>
      {totalMinutes > 0 && <span>약 {totalMinutes}분</span>}
    </div>
    {module.data.prerequisites.length > 0 && <p class="mt-3 text-sm" style="color: var(--fg-muted)">선행 지식: {module.data.prerequisites.join(', ')}</p>}
  </PageHeader>
  <ol class="grid gap-4">
    {
      units.map((u) => (
        <li>
          <a href={urls.unit(u.id)} class="flex gap-5 rounded-xl border p-5 no-underline hover:no-underline" style="border-color: var(--line)">
            <span class="text-3xl font-bold tabular-nums" style="color: var(--accent)">{String(u.data.order).padStart(2, '0')}</span>
            <div class="min-w-0">
              <h2 class="text-lg font-semibold" style="color: var(--fg)">{u.data.title}</h2>
              <p class="mt-1 text-sm" style="color: var(--fg-muted)">{u.data.summary}</p>
              <div class="mt-2 flex flex-wrap gap-2 text-xs" style="color: var(--fg-muted)">
                <Badge kind="difficulty" value={u.data.difficulty} />
                {u.data.estimatedMinutes && <span>{u.data.estimatedMinutes}분</span>}
                {u.data.prerequisites.length > 0 && <span>선행 단원 {u.data.prerequisites.length}개</span>}
              </div>
            </div>
          </a>
        </li>
      ))
    }
    {units.length === 0 && <li style="color: var(--fg-muted)">단원 준비 중입니다.</li>}
  </ol>
</BaseLayout>
