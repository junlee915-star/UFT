---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Badge from '@/components/Badge.astro';
import ProgressBar from '@/components/ProgressBar.astro';
import { getTracks, getModules, getLessons, urls, levelLabel, type TrackId } from '@/lib/content';

const tracks = await getTracks();
const modules = await getModules();
const lessons = await getLessons();

const lessonsOf = (mod: string) => lessons.filter((l) => l.data.module === mod);
const modulesOf = (track: string) => modules.filter((m) => m.data.track === track);
const lessonsOfTrack = (track: string) => lessons.filter((l) => l.data.track === track);

const totals = tracks.map((t) => {
  const ls = lessonsOfTrack(t.id);
  return {
    track: t,
    modules: modulesOf(t.id).length,
    lessons: ls.length,
    minutes: ls.reduce((s, l) => s + l.data.estMinutes, 0),
    levels: {
      intro: ls.filter((l) => l.data.level === 'intro').length,
      intermediate: ls.filter((l) => l.data.level === 'intermediate').length,
      advanced: ls.filter((l) => l.data.level === 'advanced').length,
    },
  };
});
const allMinutes = totals.reduce((s, t) => s + t.minutes, 0);
---

<BaseLayout
  title="학습 트랙"
  description="물리학·종교철학·통합 세 트랙, 15개 모듈로 짜인 통일장이론 교육과정 전체 지도"
  wide
>
  <PageHeader
    title="학습 트랙"
    lead="물리학과 종교·철학을 각자의 언어로 따로 배우고, 통합은 전용 트랙에서만 한다. 범주 오류를 구조적으로 막기 위한 설계다."
  >
    <div class="mt-5 flex flex-wrap items-center gap-2 text-sm" role="group" aria-label="난이도 필터">
      <span style="color: var(--fg-muted)">난이도</span>
      <button type="button" data-level="all" class="rounded-full border px-3 py-1 font-semibold" style="border-color: var(--line); background: var(--bg-2)" aria-pressed="true">전체</button>
      {
        (['intro', 'intermediate', 'advanced'] as const).map((l) => (
          <button type="button" data-level={l} class="rounded-full border px-3 py-1" style="border-color: var(--line)" aria-pressed="false">
            {levelLabel[l]}
          </button>
        ))
      }
    </div>
  </PageHeader>

  <section class="mb-12 grid gap-4 sm:grid-cols-3">
    {
      totals.map(({ track, modules: m, lessons: n, minutes }) => (
        <a
          href={urls.track(track.id)}
          class="rounded-xl border p-5 no-underline hover:no-underline"
          style={`border-color: var(--line); border-left: 4px solid var(--track-${track.id})`}
        >
          <p class="text-xs font-bold" style={`color: var(--track-${track.id})`}>트랙 {track.data.letter}</p>
          <h2 class="mt-1 text-xl font-bold" style="color: var(--fg)">{track.data.title}</h2>
          <p class="mt-2 text-sm" style="color: var(--fg-muted)">{track.data.subtitle}</p>
          <p class="mt-3 text-xs" style="color: var(--fg-muted)">모듈 {m}개 · 단원 {n}개 · 약 {Math.round(minutes / 60)}시간</p>
          <div class="mt-3">
            <ProgressBar scope={`track-${track.id}`} ids={lessonsOfTrack(track.id).map((l) => l.id)} compact />
          </div>
        </a>
      ))
    }
  </section>

  <section class="mb-12">
    <h2 class="mb-3 text-xl font-bold">모듈 의존 그래프</h2>
    <p class="mb-4 max-w-3xl text-sm" style="color: var(--fg-muted)">
      실선은 선수 조건이다. 트랙 C 의 각 모듈은 양쪽 트랙에서 지정된 선수 모듈을 모두 마친 뒤에만 열린다.
    </p>
    <div class="overflow-x-auto rounded-xl border p-4" style="border-color: var(--line); background: var(--bg-2)">
      <pre class="mermaid text-sm">{`flowchart LR
  A0["A0 수학 도구"] --> A1["A1 고전 장이론"]
  A1 --> A2["A2 장의 양자화"]
  A2 --> A3["A3 게이지·표준모형"]
  A3 --> A4["A4 대통일이론"]
  A4 --> A5["A5 양자중력"]
  B0["B0 방법론·범주통제"] --> B1["B1 형이상학 기초"]
  B1 --> B2["B2 창조·우주론 신학"]
  B1 --> B3["B3 통일 사유 전통"]
  B3 --> B4["B4 의식·정보·법칙"]
  A1 --> C1["C1 통일의 개념사"]
  B1 --> C1
  A3 --> C2["C2 대칭·법칙·필연"]
  B4 --> C2
  A5 --> C3["C3 근본성 논쟁"]
  C1 --> C4["C4 연구 제안서"]
  C2 --> C4
  C3 --> C4`}</pre>
    </div>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-bold">전체 규모</h2>
    <div class="overflow-x-auto rounded-xl border" style="border-color: var(--line)">
      <table class="w-full text-sm">
        <thead style="background: var(--bg-2)">
          <tr class="text-left">
            <th class="px-4 py-2.5 font-semibold">트랙</th>
            <th class="px-4 py-2.5 font-semibold">모듈</th>
            <th class="px-4 py-2.5 font-semibold">단원</th>
            <th class="px-4 py-2.5 font-semibold">학습 시간</th>
            <th class="px-4 py-2.5 font-semibold">난이도 분포</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--line)">
          {
            totals.map(({ track, modules: m, lessons: n, minutes, levels }) => (
              <tr style="border-color: var(--line)">
                <td class="px-4 py-3">
                  <a href={urls.track(track.id)} class="font-medium">{track.data.letter} {track.data.title}</a>
                </td>
                <td class="px-4 py-3 tabular-nums" style="color: var(--fg-muted)">{m}</td>
                <td class="px-4 py-3 tabular-nums" style="color: var(--fg-muted)">{n}</td>
                <td class="px-4 py-3 tabular-nums" style="color: var(--fg-muted)">{Math.round(minutes / 60)}시간</td>
                <td class="px-4 py-3" style="color: var(--fg-muted)">입문 {levels.intro} / 중급 {levels.intermediate} / 고급 {levels.advanced}</td>
              </tr>
            ))
          }
          <tr style="border-color: var(--line); background: var(--bg-2)">
            <td class="px-4 py-3 font-semibold">합계</td>
            <td class="px-4 py-3 font-semibold tabular-nums">{modules.length}</td>
            <td class="px-4 py-3 font-semibold tabular-nums">{lessons.length}</td>
            <td class="px-4 py-3 font-semibold tabular-nums">{Math.round(allMinutes / 60)}시간</td>
            <td class="px-4 py-3"></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  {
    tracks.map((t) => (
      <section class="mb-14">
        <div class="mb-4 flex flex-wrap items-baseline gap-3 border-b pb-2" style="border-color: var(--line)">
          <h2 class="text-2xl font-bold">
            <a href={urls.track(t.id)} class="no-underline hover:underline" style="color: var(--fg)">
              트랙 {t.data.letter} · {t.data.title}
            </a>
          </h2>
          <p class="text-sm" style="color: var(--fg-muted)">{t.data.question}</p>
        </div>
        <ol class="grid gap-4 md:grid-cols-2">
          {modulesOf(t.id).map((m) => (
            <li class="rounded-xl border p-5" style={`border-color: var(--line); border-left: 4px solid var(--track-${t.id})`}>
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-bold">
                  <a href={urls.module(t.id, m.id)} class="no-underline hover:underline" style="color: var(--fg)">
                    <span class="font-mono" style={`color: var(--track-${t.id})`}>{m.id.toUpperCase()}</span> {m.data.title}
                  </a>
                </h3>
                <Badge kind="level" value={m.data.level} small />
              </div>
              <p class="mt-2 text-sm" style="color: var(--fg-muted)">{m.data.summary}</p>
              <ol class="mt-3 space-y-1 text-sm">
                {lessonsOf(m.id).map((l) => (
                  <li data-unit data-level={l.data.level} class="flex items-baseline gap-2">
                    <span class="font-mono text-xs tabular-nums" style="color: var(--fg-muted)">{l.id.toUpperCase()}</span>
                    <a href={urls.lesson(l.data.track, l.data.module, l.id)} class="min-w-0 flex-1 truncate">{l.data.title}</a>
                    <Badge kind="level" value={l.data.level} small />
                  </li>
                ))}
                {lessonsOf(m.id).length === 0 && <li style="color: var(--fg-muted)">단원 준비 중</li>}
              </ol>
              {lessonsOf(m.id).length > 0 && (
                <div class="mt-3">
                  <ProgressBar scope={m.id} ids={lessonsOf(m.id).map((l) => l.id)} compact />
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>

<script>
  import mermaid from 'mermaid';
  const dark = document.documentElement.classList.contains('dark');
  mermaid.initialize({ startOnLoad: true, theme: dark ? 'dark' : 'neutral', securityLevel: 'strict', flowchart: { curve: 'basis' } });
</script>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-level]');
  const units = document.querySelectorAll<HTMLElement>('[data-unit]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const level = b.dataset.level!;
      buttons.forEach((x) => {
        const on = x === b;
        x.setAttribute('aria-pressed', String(on));
        x.style.background = on ? 'var(--bg-2)' : '';
        x.style.fontWeight = on ? '600' : '';
      });
      units.forEach((u) => (u.hidden = level !== 'all' && u.dataset.level !== level));
    }),
  );
</script>
