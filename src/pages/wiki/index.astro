---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Badge from '@/components/Badge.astro';
import { getPublished, urls } from '@/lib/content';

const wiki = (await getPublished('wiki')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'));
const initials = ['ㄱ', 'ㄲ', 'ㄴ', 'ㄷ', 'ㄸ', 'ㄹ', 'ㅁ', 'ㅂ', 'ㅃ', 'ㅅ', 'ㅆ', 'ㅇ', 'ㅈ', 'ㅉ', 'ㅊ', 'ㅋ', 'ㅌ', 'ㅍ', 'ㅎ'];
const groupKey = (title: string) => {
  const c = title.charCodeAt(0);
  if (c >= 0xac00 && c <= 0xd7a3) return initials[Math.floor((c - 0xac00) / 588)];
  if (/[A-Za-z]/.test(title[0])) return title[0].toUpperCase();
  return '기타';
};
const groups = new Map<string, typeof wiki>();
for (const w of wiki) {
  const k = groupKey(w.data.title);
  groups.set(k, [...(groups.get(k) ?? []), w]);
}
---

<BaseLayout title="수식 위키" description="통일장이론의 핵심 개념과 수식을 항목별로 정리한 위키">
  <PageHeader title="수식 위키" lead="개념 하나에 항목 하나. 정의, 핵심 수식, 관련 항목으로 구성되며 항목 사이 링크는 역방향으로도 표시됩니다.">
    <p class="mt-3 text-sm" style="color: var(--fg-muted)">{wiki.length}개 항목 · <a href="/search">검색</a></p>
  </PageHeader>
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      [...groups.entries()].map(([k, list]) => (
        <section>
          <h2 class="mb-2 text-sm font-semibold" style="color: var(--fg-muted)">{k}</h2>
          <ul class="space-y-3">
            {list.map((w) => (
              <li>
                <a href={urls.wiki(w.id)} class="font-medium">{w.data.title}</a>
                {w.data.titleEn && <span class="ml-1.5 text-xs" style="color: var(--fg-muted)">{w.data.titleEn}</span>}
                <span class="ml-1.5 align-middle"><Badge kind="difficulty" value={w.data.difficulty} /></span>
                <p class="text-sm" style="color: var(--fg-muted)">{w.data.summary}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
