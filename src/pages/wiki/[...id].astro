---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import Backlinks from '@/components/Backlinks.astro';
import { getEntry, render } from 'astro:content';
import { getPublished, getAllArticles, findBacklinks, urls, paths, withBase } from '@/lib/content';

export async function getStaticPaths() {
  return (await getPublished('wiki')).map((w) => ({ params: { id: w.id }, props: { entry: w } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getAllArticles();
const related = (await Promise.all(entry.data.related.map((id) => getEntry('wiki', id)))).filter(
  (e): e is NonNullable<typeof e> => e !== undefined && !e.data.draft,
);
const backlinks = findBacklinks(all, paths.wiki(entry.id), entry);
for (const w of all) {
  if (w.collection === 'wiki' && w.id !== entry.id && w.data.related.includes(entry.id) && !backlinks.includes(w)) backlinks.push(w);
}
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  kicker={entry.data.titleEn ? `수식 위키 · ${entry.data.titleEn}` : '수식 위키'}
  kickerHref={withBase('/wiki')}
  created={entry.data.created}
  updated={entry.data.updated}
  author={entry.data.author}
  tags={entry.data.tags}
  difficulty={entry.data.difficulty}
  status={entry.data.status}
  headings={headings}
  draft={entry.data.draft}
>
  <Fragment slot="meta">
    {entry.data.aliases.length > 0 && <p class="mt-3 text-sm" style="color: var(--fg-muted)">다른 이름: {entry.data.aliases.join(', ')}</p>}
  </Fragment>
  <Content />
  <Fragment slot="after">
    {
      related.length > 0 && (
        <section class="mt-12" data-pagefind-ignore>
          <h2 class="text-base font-semibold">관련 항목</h2>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {related.map((r) => (
              <li>
                <a href={urls.wiki(r.id)} class="block rounded-lg border p-3 no-underline hover:no-underline" style="border-color: var(--line)">
                  <span class="font-medium" style="color: var(--fg)">{r.data.title}</span>
                  <span class="block text-xs" style="color: var(--fg-muted)">{r.data.summary}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <Backlinks entries={backlinks} />
  </Fragment>
</ArticleLayout>
