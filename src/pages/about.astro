---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Badge from '@/components/Badge.astro';
import { statusMeaning, urls, aiAssistedLabel } from '@/lib/content';

const principles = [
  ['범주적 분리', '물리 단원은 물리적 주장만, 철학·신학 단원은 형이상학적 주장만 한다. 통합은 트랙 C 에서만 하며, 트랙 C 의 모든 주장은 어느 단원을 근거로 삼는지 명시한다.'],
  ['수식 이전에 동기', '모든 단원은 "이 수식이 없었을 때 무엇을 설명하지 못했는가"로 시작한다. 역사적 맥락 없는 수식 나열은 쓰지 않는다.'],
  ['유도는 생략하지 않는다', '결과 수식만 제시하고 "유도는 교과서 어딘가에"로 넘기지 않는다. 분량이 넘치면 단원을 나눈다.'],
  ['1차 문헌 직접 인용', '트랙 B 는 원전을 번역본으로라도 반드시 직접 인용한다. 트랙 A 는 가능한 한 원논문을 가리킨다.'],
  ['산출물 있는 단원', '모든 단원은 마치면 손으로 재현할 수 있는 것 하나를 남긴다. 계산 하나, 증명 하나, 또는 재진술 요지 하나.'],
  ['가설은 명제로', '통합 트랙에서 자기 생각을 쓸 때는 부정 가능한 문장으로 진술한다. 부정 가능하지 않은 명제는 형이상학적 전제로 분리 표기한다.'],
];

const rubric = [
  ['1 부족', '수식을 보면서만 재현한다', '원전 인용 없이 인상을 쓴다'],
  ['2 부분', '유도 경로는 알지만 중간에서 막힌다', '논증을 요약하나 전제를 모두 찾지 못한다'],
  ['3 통과', '백지에서 유도하고 가정을 말한다', '전제-결론을 번호로 짜고 의존 관계를 보인다'],
  ['4 숙달', '다른 가정에서 다시 유도해 본다', '자기 반론을 만들고 그에 다시 답한다'],
];

const questionTypes = [
  ['1 유도형', '수식을 전제에서 직접 만들 수 있는가', '주어진 라그랑지안에서 운동방정식을 얻어라'],
  ['2 계산형', '수를 끝까지 내는가', '혼합각 값에서 Z 보손 질량을 구하라'],
  ['3 개념 진술형', '수식 없이 다시 설명하는가', '게이지 대칭이 왜 필요한지 300자로'],
  ['4 논증 재구성형', '원전의 논증을 전제-결론으로 재구성하는가', '에티카 1부 정리 14를 번호 논증으로'],
  ['5 반론 작성형', '가장 센 반론을 직접 만드는가', '미세조정 논증에 대한 반례를 하나'],
  ['6 오류 진단형', '섞인 문장을 가려내는가', '이 단락에서 범주 오류를 찾아 지적하라'],
];
---

<BaseLayout title="사이트 소개" description="교육과정 설계 원칙, 검토 상태의 뜻, AI 보조 사용 범위, 평가 루브릭">
  <PageHeader
    title="사이트 소개"
    lead="통일장이론을 물리학과 종교·철학 두 갈래로 가르치고, 통합은 전용 트랙에서만 한다. 이 페이지는 그 규칙과 이 사이트가 자기 글에 매기는 표시를 설명한다."
  />

  <section class="prose mb-14">
    <h2>무엇을 하는 사이트인가</h2>
    <p>
      물리학만 가르치면 통합 관점의 언어가 없고, 철학만 가르치면 물리학 주장의 진위를 판별할 수 없다.
      그래서 <a href={urls.track('physics')}>트랙 A</a>와 <a href={urls.track('philosophy')}>트랙 B</a>를 따로 세우고,
      둘을 겹치는 일은 <a href={urls.track('synthesis')}>트랙 C</a>에서만 한다. 범주 오류를 구조적으로 막기 위해서다.
    </p>
    <p>
      학습자는 학부 물리학 수준(다변수 미적분, 선형대수, 양자역학 1년, 특수상대론)을 전제하고,
      도달점은 대학원 1년차 수준이다. 구체적으로는 게이지 이론 교과서를 혼자 읽고, 관련 arXiv 논문의 논지를 따라가며,
      자기 연구 제안서를 쓸 수 있는 상태다.
    </p>
    <p>
      물리학을 배우지 않은 독자도 트랙 B 로 들어와 읽을 수 있다. 다만 트랙 C 로 넘어가려면
      트랙 A 모듈 1 의 자기 평가를 통과해야 한다. 수식을 읽지 않는 독자는 각 단원 머리의 "수식 없는 요지" 박스와
      <a href={urls.essay('').replace(/\/$/, '')}>개념 글</a>에서 닫을 수 있다.
    </p>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 text-2xl font-bold">교육과정 설계 원칙</h2>
    <p class="mb-4 max-w-3xl" style="color: var(--fg-muted)">이 원칙을 어긴 원고는 검토 상태를 올리지 않는다.</p>
    <ol class="grid gap-3">
      {
        principles.map(([t, d], i) => (
          <li class="rounded-xl border p-4" style="border-color: var(--line)">
            <p class="font-semibold"><span class="mr-2 font-mono" style="color: var(--accent)">{i + 1}</span>{t}</p>
            <p class="mt-1 text-sm" style="color: var(--fg-muted)">{d}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 text-2xl font-bold">검토 상태</h2>
    <p class="mb-4 max-w-3xl" style="color: var(--fg-muted)">
      모든 글에 검토 상태를 강제로 부여한다. 물리 단원은 수식 유도를 다시 한번 직접 풀기 전에는 검토 완료로 올리지 않고,
      트랙 C 단원은 자기 가설을 담으므로 원칙상 검토 완료를 부여하지 않는다.
    </p>
    <ul class="grid gap-3">
      {
        (['draft', 'review', 'verified'] as const).map((s) => (
          <li class="flex flex-wrap items-baseline gap-3 rounded-xl border p-4" style="border-color: var(--line)">
            <Badge kind="status" value={s} />
            <span class="flex-1 text-sm" style="color: var(--fg-muted)">{statusMeaning[s]}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 text-2xl font-bold">AI 보조 사용 공지</h2>
    <p class="mb-4 max-w-3xl" style="color: var(--fg-muted)">
      글마다 AI 보조 범위를 기록하고 본문 하단에 그대로 표시한다. 수식 유도와 원전 번역은 사람이 확인한 뒤에만 검토 완료로 올린다.
      즉 <strong>검토 완료 표시가 없는 글의 수식과 번역은 아직 사람이 대조하지 않은 것</strong>으로 읽어야 한다.
    </p>
    <ul class="grid gap-2 sm:grid-cols-2">
      {
        (['none', 'outline', 'draft', 'translation'] as const).map((a) => (
          <li class="rounded-lg border p-3 text-sm" style="border-color: var(--line)">
            <strong>{aiAssistedLabel[a]}</strong>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 text-2xl font-bold">평가와 학습 진도</h2>
    <p class="mb-4 max-w-3xl" style="color: var(--fg-muted)">
      평가는 전부 자기 평가다. 사이트는 정답을 저장하지 않고 채점하지도 않는다. 학습자가 자기 글을 루브릭에 대어 보고 스스로 통과 여부를 정한다.
    </p>
    <h3 class="mb-2 mt-6 text-lg font-semibold">문항 유형</h3>
    <div class="overflow-x-auto rounded-xl border" style="border-color: var(--line)">
      <table class="w-full text-sm">
        <thead style="background: var(--bg-2)">
          <tr class="text-left">
            <th class="px-4 py-2.5 font-semibold">유형</th>
            <th class="px-4 py-2.5 font-semibold">물어보는 것</th>
            <th class="hidden px-4 py-2.5 font-semibold md:table-cell">예</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--line)">
          {
            questionTypes.map(([a, b, c]) => (
              <tr style="border-color: var(--line)">
                <td class="px-4 py-2.5 font-medium whitespace-nowrap">{a}</td>
                <td class="px-4 py-2.5" style="color: var(--fg-muted)">{b}</td>
                <td class="hidden px-4 py-2.5 md:table-cell" style="color: var(--fg-muted)">{c}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <h3 class="mb-2 mt-8 text-lg font-semibold">체크포인트 루브릭</h3>
    <p class="mb-3 text-sm" style="color: var(--fg-muted)">통과 기준은 3수준 이상이다.</p>
    <div class="overflow-x-auto rounded-xl border" style="border-color: var(--line)">
      <table class="w-full text-sm">
        <thead style="background: var(--bg-2)">
          <tr class="text-left">
            <th class="px-4 py-2.5 font-semibold">수준</th>
            <th class="px-4 py-2.5 font-semibold">물리 모듈</th>
            <th class="px-4 py-2.5 font-semibold">철학·통합 모듈</th>
          </tr>
        </thead>
        <tbody class="divide-y" style="border-color: var(--line)">
          {
            rubric.map(([lv, p, q]) => (
              <tr style="border-color: var(--line)">
                <td class="px-4 py-2.5 font-medium whitespace-nowrap">{lv}</td>
                <td class="px-4 py-2.5" style="color: var(--fg-muted)">{p}</td>
                <td class="px-4 py-2.5" style="color: var(--fg-muted)">{q}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-14">
    <h2 class="mb-4 text-2xl font-bold">학습 진도 데이터</h2>
    <p class="mb-4 max-w-3xl" style="color: var(--fg-muted)">
      서버가 없으므로 진도는 이 브라우저의 저장소에만 남는다. 기기를 바꾸면 따라오지 않고, 사이트 운영자도 볼 수 없다.
      기기를 옮길 때는 JSON 으로 내보내고 가져온다.
    </p>
    <div class="flex flex-wrap items-center gap-3 text-sm">
      <button type="button" data-progress-export class="rounded-lg border px-4 py-2 font-medium" style="border-color: var(--line)">진도 내보내기</button>
      <label class="cursor-pointer rounded-lg border px-4 py-2 font-medium" style="border-color: var(--line)">
        진도 가져오기
        <input type="file" accept="application/json" data-progress-import class="hidden" />
      </label>
      <button type="button" data-progress-reset class="rounded-lg border px-4 py-2 font-medium" style="border-color: var(--line); color: var(--accent-2)">진도 지우기</button>
    </div>
  </section>

  <section class="prose">
    <h2>인용과 저작권</h2>
    <p>
      본문은 CC BY-SA 4.0, 사이트 코드는 MIT 다. 그림은 직접 제작한 SVG 만 싣고 교과서 스캔은 쓰지 않는다.
      논문은 요약과 링크만 싣고 본문을 옮기지 않는다. 트랙 B 의 원전은 번역본 인용을 단원당 200자 이하로 제한하고 출처를 명시하며,
      긴 대목은 원문과 자기 번역을 함께 싣는다.
    </p>
    <p>모든 참고문헌은 <a href={urls.bib()}>참고문헌 페이지</a>에서 인용 키와 함께 볼 수 있다.</p>
  </section>
</BaseLayout>
