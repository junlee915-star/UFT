---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Card from '@/components/Card.astro';
import { getNotes, getPapers, urls } from '@/lib/content';
import { loadBib } from '@/lib/bibtex.mjs';

const notes = await getNotes();
const papers = await getPapers();
const bibCount = loadBib('./src/data/references.bib').length;
const hubs = [
  { label: '연구 노트', n: notes.length, href: urls.note('').replace(/\/$/, ''), desc: '날짜·태그별로 정리한 자유 형식 노트' },
  { label: '논문 요약', n: papers.length, href: urls.paper('').replace(/\/$/, ''), desc: 'arXiv ID·DOI 메타데이터와 한국어 요약' },
  { label: '참고문헌', n: bibCount, href: urls.bib(), desc: 'BibTeX 한 파일로 관리하는 서지 목록' },
];
---

<BaseLayout title="연구" description="통일장이론 연구 노트, 논문 요약, 참고문헌 데이터베이스">
  <PageHeader
    title="연구"
    lead="학습 트랙 바깥에서 쌓는 기록. 모든 글은 인용 키로 참고문헌과, wikiRefs 로 개념 위키와 이어진다."
  />
  <div class="grid gap-4 sm:grid-cols-3">
    {
      hubs.map((h) => (
        <a href={h.href} class="rounded-xl border p-5 no-underline hover:no-underline" style="border-color: var(--line)">
          <p class="text-sm" style="color: var(--fg-muted)">{h.label}</p>
          <p class="mt-1 text-3xl font-bold tabular-nums" style="color: var(--fg)">{h.n}</p>
          <p class="mt-2 text-sm" style="color: var(--fg-muted)">{h.desc}</p>
        </a>
      ))
    }
  </div>
  <section class="mt-12">
    <h2 class="mb-4 text-2xl font-bold">최근 글</h2>
    <ul class="grid gap-4 sm:grid-cols-2">
      {notes.slice(0, 4).map((n) => (
        <li><Card href={urls.note(n.id)} kicker="연구 노트" title={n.data.title} summary={n.data.summary} date={n.data.updated ?? n.data.date} status={n.data.status} tags={n.data.tags} /></li>
      ))}
      {papers.slice(0, 4).map((p) => (
        <li><Card href={urls.paper(p.id)} kicker={`논문 요약 · ${p.data.year}`} title={p.data.titleKo} summary={p.data.summaryKo} status={p.data.status} tags={p.data.tags} /></li>
      ))}
    </ul>
  </section>
</BaseLayout>
