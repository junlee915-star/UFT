---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { loadBib, formatEntry } from '@/lib/bibtex.mjs';
import { getAllArticles, urlOf } from '@/lib/content';

const entries = [...loadBib('./src/data/references.bib')].sort((a, b) => (a.fields.year ?? '').localeCompare(b.fields.year ?? '') || a.key.localeCompare(b.key));
const all = await getAllArticles();
const citedBy = new Map<string, typeof all>();
for (const e of all) {
  for (const m of (e.body ?? '').matchAll(/\[@([^\]]+)\]/g)) {
    for (const k of m[1].split(/[;,]/).map((s) => s.trim().replace(/^@/, ''))) {
      if (!citedBy.has(k)) citedBy.set(k, []);
      if (!citedBy.get(k)!.includes(e)) citedBy.get(k)!.push(e);
    }
  }
}
---

<BaseLayout title="참고문헌" description="사이트 전체에서 인용하는 참고문헌 목록(BibTeX)">
  <PageHeader kicker="연구" title="참고문헌" lead={`src/data/references.bib 파일 하나로 관리합니다. 본문에서 [@키] 형식으로 인용하면 글 끝에 참고문헌 절이 자동 생성됩니다. 총 ${entries.length}건.`}>
    <p class="mt-3 text-sm"><a href="https://github.com/junlee915-star/UFT/blob/main/src/data/references.bib" rel="noopener">BibTeX 원본 보기</a></p>
  </PageHeader>
  <ol class="space-y-4">
    {
      entries.map((e) => (
        <li id={`ref-${e.key}`} class="rounded-lg border p-4 text-sm" style="border-color: var(--line); scroll-margin-top: 5rem">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <code class="text-xs" style="color: var(--fg-muted)">@{e.type}&#123;{e.key}&#125;</code>
            <span class="text-xs" style="color: var(--fg-muted)">인용 {citedBy.get(e.key)?.length ?? 0}회</span>
          </div>
          <p class="mt-1.5" set:html={formatEntry(e)} />
          {citedBy.get(e.key) && (
            <p class="mt-1.5 text-xs" style="color: var(--fg-muted)">
              인용한 글: {citedBy.get(e.key)!.map((a, i) => (<>{i > 0 && ', '}<a href={urlOf(a)}>{a.data.title}</a></>))}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</BaseLayout>
