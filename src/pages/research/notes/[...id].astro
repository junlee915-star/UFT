---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import Backlinks from '@/components/Backlinks.astro';
import { render } from 'astro:content';
import { getPublished, getAllArticles, findBacklinks, urls } from '@/lib/content';

export async function getStaticPaths() {
  return (await getPublished('notes')).map((n) => ({ params: { id: n.id }, props: { entry: n } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const backlinks = findBacklinks(await getAllArticles(), urls.note(entry.id), entry);
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  kicker="연구 노트"
  kickerHref="/research/notes"
  created={entry.data.created}
  updated={entry.data.updated}
  author={entry.data.author}
  tags={entry.data.tags}
  difficulty={entry.data.difficulty}
  status={entry.data.status}
  headings={headings}
  draft={entry.data.draft}
>
  <Content />
  <Fragment slot="after"><Backlinks entries={backlinks} title="이 노트를 참조하는 글" /></Fragment>
</ArticleLayout>
