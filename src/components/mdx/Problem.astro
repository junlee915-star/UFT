---
/**
 * 연습문제. 문제는 항상 보이고 해설은 <Solution> 안에 넣어 접는다.
 * 모든 문제에는 해설이 있어야 하며, 검사 스크립트가 이를 확인한다.
 */
interface Props {
  /** 문제 번호 */
  n: number | string;
  /** 평가 문항 유형 (유도형·계산형·개념 진술형·논증 재구성형·반론 작성형·오류 진단형) */
  type?: string;
}
const { n, type } = Astro.props;
---

<div class="problem">
  <p class="problem-head">
    <span class="problem-n">문제 {n}</span>
    {type && <span class="problem-type">{type}</span>}
  </p>
  <div class="problem-body"><slot /></div>
</div>

<style>
  .problem {
    margin-block: 1.2em;
    padding: 0.9em 1.1em;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
  }
  .problem-head {
    margin: 0 0 0.5em;
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }
  .problem-n {
    font-weight: 700;
    font-size: 0.9em;
  }
  .problem-type {
    font-size: 0.75em;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--bg-2);
    color: var(--fg-muted);
  }
  .problem-body :global(> :first-child) {
    margin-top: 0;
  }
  .problem-body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
