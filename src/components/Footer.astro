---
import { withBase } from '@/lib/content';
const year = new Date().getFullYear();
const links = [
  { href: '/glossary', label: '한·영 용어' },
  { href: '/bib', label: '참고문헌' },
  { href: '/tags', label: '태그' },
  { href: '/rss.xml', label: 'RSS' },
];
---

<footer class="mt-16 border-t" style="border-color: var(--line)">
  <div class="mx-auto flex max-w-7xl flex-col gap-3 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8" style="color: var(--fg-muted)">
    <p>© {year} 통일장이론 교육과정. 본문은 CC BY-SA 4.0, 코드는 MIT.</p>
    <nav class="flex flex-wrap gap-4" aria-label="보조 메뉴">
      {links.map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
      <a href="https://github.com/junlee915-star/UFT" rel="noopener">GitHub</a>
    </nav>
  </div>
</footer>
