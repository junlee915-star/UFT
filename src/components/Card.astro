---
import Badge from './Badge.astro';
import { formatDate } from '@/lib/content';
interface Props {
  href: string;
  title: string;
  summary?: string;
  kicker?: string;
  date?: Date;
  level?: string;
  status?: string;
  track?: string;
  tags?: string[];
  meta?: string;
  accent?: string;
}
const { href, title, summary, kicker, date, level, status, track, tags = [], meta, accent } = Astro.props;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-xl border p-5 no-underline transition-colors hover:no-underline"
  style={`border-color: var(--line); background: var(--bg); ${accent ? `border-left: 4px solid ${accent};` : ''}`}
>
  {kicker && <p class="mb-1 text-xs font-medium" style={`color: ${accent ?? 'var(--accent)'}`}>{kicker}</p>}
  <h3 class="text-lg font-semibold leading-snug group-hover:underline" style="color: var(--fg)">{title}</h3>
  {summary && <p class="mt-2 line-clamp-3 text-sm" style="color: var(--fg-muted)">{summary}</p>}
  <div class="mt-auto flex flex-wrap items-center gap-2 pt-4 text-xs" style="color: var(--fg-muted)">
    {date && <time datetime={date.toISOString()}>{formatDate(date)}</time>}
    {meta && <span>{meta}</span>}
    {track && <Badge kind="track" value={track} small />}
    {level && <Badge kind="level" value={level} small />}
    {status && status !== 'verified' && <Badge kind="status" value={status} small />}
    {tags.slice(0, 3).map((t) => <span>#{t}</span>)}
  </div>
</a>
