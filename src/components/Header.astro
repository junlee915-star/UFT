---
import ThemeToggle from './ThemeToggle.astro';
const nav = [
  { href: '/learn', label: '학습' },
  { href: '/research', label: '연구' },
  { href: '/wiki', label: '위키' },
  { href: '/tags', label: '태그' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-20 border-b backdrop-blur" style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent)">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2 font-bold tracking-tight no-underline hover:no-underline" style="color: var(--fg)">
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-md text-sm font-black text-white" style="background: var(--accent)">∮</span>
      <span class="hidden sm:inline">통일장이론</span>
    </a>
    <nav class="flex items-center gap-1 text-sm" aria-label="주 메뉴">
      {
        nav.map((n) => (
          <a
            href={n.href}
            aria-current={isActive(n.href) ? 'page' : undefined}
            class:list={['rounded-md px-2.5 py-1.5 no-underline hover:no-underline', isActive(n.href) ? 'font-semibold' : '']}
            style={isActive(n.href) ? 'background: var(--bg-2); color: var(--fg)' : 'color: var(--fg-muted)'}
          >
            {n.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a href="/search" class="rounded-md p-2 no-underline hover:no-underline" style="color: var(--fg-muted)" aria-label="검색" title="검색">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
