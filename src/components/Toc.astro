---
import type { MarkdownHeading } from 'astro';
interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
---

<nav aria-label="목차" class="text-sm">
  <p class="mb-2 font-semibold" style="color: var(--fg-muted)">목차</p>
  <ul class="space-y-1 border-l" style="border-color: var(--line)">
    {
      headings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={['block border-l-2 -ml-px py-0.5 no-underline hover:underline', h.depth === 3 ? 'pl-6' : 'pl-3']}
            style="border-color: transparent; color: var(--fg-muted)"
            data-toc-link
          >
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<script>
  // 현재 보이는 절 강조
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const map = new Map(links.map((l) => [decodeURIComponent(l.hash.slice(1)), l]));
  const obs = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const link = map.get(e.target.id);
        if (!link) continue;
        if (e.isIntersecting) {
          links.forEach((l) => ((l.style.borderColor = 'transparent'), (l.style.color = 'var(--fg-muted)')));
          link.style.borderColor = 'var(--accent)';
          link.style.color = 'var(--fg)';
        }
      }
    },
    { rootMargin: '-80px 0px -70% 0px' },
  );
  map.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) obs.observe(el);
  });
</script>
