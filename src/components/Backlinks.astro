---
import { collectionLabel, urlOf, type AnyEntry } from '@/lib/content';
interface Props {
  entries: AnyEntry[];
  title?: string;
}
const { entries, title = '이 항목을 참조하는 글' } = Astro.props;
---

{
  entries.length > 0 && (
    <section class="mt-12 rounded-xl border p-5" style="border-color: var(--line); background: var(--bg-2)" data-pagefind-ignore>
      <h2 class="text-base font-semibold">{title}</h2>
      <ul class="mt-3 space-y-1.5 text-sm">
        {entries.map((e) => (
          <li>
            <span class="mr-2 text-xs" style="color: var(--fg-muted)">
              {collectionLabel[e.collection]}
            </span>
            <a href={urlOf(e)}>{e.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )
}
